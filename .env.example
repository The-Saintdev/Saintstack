# ==========================================================
# SaintStack Environment Variables
# ==========================================================

# Neon PostgreSQL connection string (pooled or direct)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Master API key used by coding agents (Claude Code, Codex, Antigravity)
# Generate a secure random token (e.g., using `openssl rand -hex 32`)
SAINTSTACK_API_KEY=saint_sec_replace_with_your_secure_random_key

# Environment ('production' | 'development')
ENVIRONMENT=production
